{
  "name": "ezdraft",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present --filter \"!./spikes/**\" run typecheck",
    "lint": "node scripts/conventions/check.mjs && pnpm -r --if-present --filter \"!./spikes/**\" run lint",
    "test": "pnpm run db:up && node --test --test-concurrency=4 \"scripts/**/*.test.mjs\" && pnpm -r --if-present --filter \"!./spikes/**\" run test",
    "build": "pnpm -r --if-present --filter \"!./spikes/**\" run build",
    "db:up": "node scripts/db/local.mjs up",
    "db:env": "node scripts/db/local.mjs env",
    "db:reset": "supabase db reset --local",
    "db:stop": "supabase stop",
    "db:types": "node scripts/db/gen-types.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
