{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "todoFeatureEnabled": false,
  "promptSuggestionEnabled": false,
  "autoCompactEnabled": false,
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(node scripts/gate.mjs*)",
      "Bash(node vault/tools/next_ticket.mjs*)",
      "Bash(node vault/tools/gen_acs.mjs*)",
      "Bash(npx playwright *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git fetch origin*)",
      "Bash(git merge-base *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git worktree *)",
      "Bash(git merge --squash *)",
      "Bash(git push origin develop)",
      "Bash(git branch -D t/EZD-*)",
      "Bash(git switch develop)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh api *)",
      "Bash(supabase start*)",
      "Bash(supabase stop*)",
      "Bash(supabase db reset*)",
      "Bash(supabase gen types*)",
      "Bash(supabase migration new *)",
      "Bash(pnpm supabase start*)",
      "Bash(pnpm supabase stop*)",
      "Bash(pnpm supabase db reset*)",
      "Bash(pnpm supabase gen types*)",
      "Bash(pnpm supabase migration new *)"
    ],
    "ask": [
      "Bash(gh pr merge*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(./scripts/launcher.config.json)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)",
      "Bash(vercel --prod*)",
      "Bash(vercel deploy --prod*)",
      "Bash(vercel promote*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(supabase db push*)",
      "Bash(supabase link*)",
      "Bash(pnpm supabase db push*)",
      "Bash(pnpm supabase link*)",
      "Bash(pnpm release:*)",
      "Bash(node scripts/release/promote*)",
      "Bash(node scripts/release/tag*)",
      "Bash(node scripts/release/env-check*)",
      "Bash(node scripts/run.mjs*)",
      "Bash(node scripts/budget.mjs*)",
      "Bash(claude *)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_TOTAL_TOKENS_REMINDER": "off",
    "CLAUDE_CODE_GOAL_CHECKIN_MINUTES": "0"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.mjs"] }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-paths.mjs"] }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.mjs"] }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-ledger-check.mjs"] }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-failure.mjs"] }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-end.mjs"], "timeout": 30 }
        ]
      }
    ]
  }
}
