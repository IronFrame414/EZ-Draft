{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "fallbackModel": [
    "sonnet"
  ],
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(node scripts/gate.mjs*)",
      "Bash(npx playwright *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git worktree *)",
      "Bash(git merge --squash *)",
      "Bash(git push origin develop)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(supabase start*)",
      "Bash(supabase stop*)",
      "Bash(supabase db reset*)",
      "Bash(supabase gen types*)",
      "Bash(supabase migration new *)",
      "Bash(git branch -D t/EZD-*)",
      "Bash(git switch develop)",
      "Bash(pnpm supabase start*)",
      "Bash(pnpm supabase stop*)",
      "Bash(pnpm supabase db reset*)",
      "Bash(pnpm supabase gen types*)",
      "Bash(pnpm supabase migration new *)",
      "Bash(node vault/tools/next_ticket.mjs*)"
    ],
    "ask": [
      "Bash(gh pr merge*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)",
      "Bash(vercel --prod*)",
      "Bash(vercel deploy --prod*)",
      "Bash(vercel promote*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(supabase db push*)",
      "Bash(supabase link*)",
      "Bash(pnpm supabase db push*)",
      "Bash(pnpm supabase link*)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "6",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_GOAL_CHECKIN_MINUTES": "30"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.mjs"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-paths.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.mjs"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-end.mjs"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/ledger-check.mjs"
            ]
          }
        ]
      }
    ]
  }
}
