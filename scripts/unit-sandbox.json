{
  "env": {
    "DO_NOT_TRACK": "1",
    "npm_config_cache": "/tmp/claude-501/npm-cache"
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "enableWeakerNetworkIsolation": true,
    "filesystem": {
      "allowWrite": [
        "./",
        "~/Library/Logs/ezdraft/inflight",
        "~/Library/pnpm/store",
        "/private/tmp/pnpm-store-operation-locks-501"
      ],
      "denyRead": [
        "./scripts/launcher.config.json",
        "./**/.env",
        "./**/.env.local",
        "./**/.env.*.local",
        "./**/.env.production",
        "./**/.env.development",
        "~/.claude/.credentials.json",
        "~/.ssh",
        "~/.aws",
        "~/Library/Keychains",
        "~/.config/gh",
        "~/.git-credentials",
        "~/.netrc"
      ],
      "denyWrite": [
        "/Users/josh/Projects/ezdraft/scripts",
        "/Users/josh/Projects/ezdraft/.git/config",
        "/Users/josh/Projects/ezdraft/.git/config.worktree",
        "/Users/josh/Projects/ezdraft/.git/commondir",
        "~/.ezdraft-github-ops",
        "/Users/josh/Projects/ezdraft/vault/tools"
      ]
    },
    "network": {
      "strictAllowlist": true,
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org"
      ],
      "allowLocalBinding": true,
      "allowUnixSockets": [
        "~/.docker/run/docker.sock"
      ]
    },
    "excludedCommands": [
      "node scripts/gate.mjs *",
      "node scripts/unit-steps.mjs worktree *",
      "node scripts/unit-steps.mjs merge *",
      "node scripts/ui-run.mjs *",
      "node /Users/josh/Projects/ezdraft/scripts/release/github-ops.mjs *"
    ]
  }
}
