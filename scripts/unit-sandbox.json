{
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "enableWeakerNetworkIsolation": true,
    "filesystem": {
      "allowWrite": [
        "./",
        "~/Library/Logs/ezdraft/inflight",
        "~/.supabase",
        "~/Library/pnpm/store",
        "/private/tmp/pnpm-store-operation-locks-501"
      ],
      "denyRead": [
        "./scripts/launcher.config.json",
        "./**/.env",
        "./**/.env.local",
        "./**/.env.*.local",
        "./**/.env.production",
        "./**/.env.development",
        "~/.claude/.credentials.json",
        "~/.ssh",
        "~/.aws"
      ]
    },
    "network": {
      "strictAllowlist": true,
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org"
      ],
      "allowLocalBinding": true,
      "allowUnixSockets": [
        "~/.docker/run/docker.sock"
      ]
    },
    "excludedCommands": [
      "node scripts/gate.mjs *",
      "node scripts/unit-steps.mjs worktree *",
      "node scripts/unit-steps.mjs merge *"
    ]
  }
}
